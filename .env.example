# Server-side only; never exposed to the browser.
# Locally: copy to .env.local. On Vercel: Project → Settings → Environment Variables.

# Your Anthropic key. Only used for requests that carry TALLY_ACCESS_CODE.
ANTHROPIC_API_KEY=sk-ant-...

# Unlocks ANTHROPIC_API_KEY. If unset, the server key is never used (fails closed)
# and visitors must bring their own key. Generate one: openssl rand -base64 24
TALLY_ACCESS_CODE=
